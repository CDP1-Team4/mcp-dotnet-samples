{
  "inputs": [
    {
      "type": "promptString",
      "id": "client-id",
      "description": "The client ID for Entra ID"
    }
  ],
  "servers": {
    "onedrive-download": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/microsoft/mcp-dotnet-samples/onedrive-download:latest",
        "--client-id",
        "${input:client-id}"
      ]
    }
  }
}
